{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monitor Configuration",
  "description": "Configuration schema for virtual display monitors",
  "type": "array",
  "minItems": 1,
  "maxItems": 10,
  "items": {
    "type": "object",
    "required": ["id", "width", "height"],
    "properties": {
      "id": {
      "type": "string",
 "description": "Unique identifier for the monitor",
        "pattern": "^[a-zA-Z0-9_-]+$",
    "minLength": 1,
        "maxLength": 50
      },
    "width": {
     "type": "integer",
    "description": "Monitor width in pixels",
        "minimum": 640,
     "maximum": 7680
  },
    "height": {
        "type": "integer",
        "description": "Monitor height in pixels",
  "minimum": 480,
        "maximum": 4320
      },
      "refreshRate": {
        "type": "integer",
        "description": "Refresh rate in Hz",
        "default": 60,
      "enum": [60, 75, 90, 120, 144, 240]
      },
  "position": {
        "type": "object",
        "description": "Monitor position relative to primary display",
        "properties": {
          "x": {
       "type": "integer",
       "description": "Horizontal position in pixels"
          },
    "y": {
 "type": "integer",
          "description": "Vertical position in pixels"
 }
        },
        "required": ["x", "y"]
      },
      "primary": {
        "type": "boolean",
        "description": "Whether this is the primary monitor",
        "default": false
      }
    },
    "additionalProperties": false
  }
}
